# ============ 管理员账号（推荐用法） ============
# 首次启动（data/ 为空）时用它创建管理员，之后改这里不会自动生效
ADMIN_USERNAME=admin
ADMIN_PASSWORD=please-change-me

# 忘记密码：把 ADMIN_PASSWORD 改成新密码，把 ADMIN_SYNC 设 1，重启一次后端；
# 密码已同步后可改回 0（否则每次重启都会覆盖后台改过的密码）
ADMIN_SYNC=0

# ============ 万能 Token（可选，v2 遗留） ============
# 留空 = 不使用。填了且 ALLOW_ADMIN_TOKEN=1 时，可用 Bearer <token> 直接以管理员身份调用 API
ADMIN_TOKEN=
# 0 = 关闭 Token 直登（只保留账号密码登录）；1 = 开启
ALLOW_ADMIN_TOKEN=0

# ============ 其他 ============
# web 对外端口
WEB_PORT=8300

# 单文件上传上限等均在后台「上传限制」里配置（默认单图 5MB）
# 随机图接口每 IP 每分钟限流次数，0 = 关闭
RATE_LIMIT=120
