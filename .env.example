# ============ 管理员账号 ============
# 首次启动（data/ 为空）时用它创建管理员，之后改这里不会自动生效
ADMIN_USERNAME=admin
ADMIN_PASSWORD=please-change-me

# 忘记密码：把 ADMIN_PASSWORD 改成新密码，把 ADMIN_SYNC 设 1，重启一次后端；
# 密码已同步后改回 0（否则每次重启都会覆盖后台改过的密码）
ADMIN_SYNC=0

# ============ 网络 ============
# web 对外端口
WEB_PORT=8300
TZ=Asia/Shanghai

# Go 运行时软限制（不包含图片处理子进程与文件缓存）
GOMEMLIMIT=40MiB
GOGC=50
# 仅当接入可信反向代理时填写其 IP/CIDR，逗号分隔；默认不信任客户端 IP 请求头
TRUSTED_PROXIES=

# ============ 防御 ============
# 随机图接口每 IP 每分钟限流次数，0 = 关闭
RATE_LIMIT=120

# 说明：单文件上传上限、压缩参数、webhook 等均在后台管理面板配置（存数据库，热生效）
